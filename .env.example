# FlowCast environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
FLOWCAST_ENV=development
FLOWCAST_HTTP_PORT=8080
FLOWCAST_LOG_LEVEL=info

# --- PostgreSQL ---
FLOWCAST_DATABASE_URL=postgres://flowcast:flowcast@localhost:5432/flowcast?sslmode=disable

# --- Redis ---
FLOWCAST_REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate with: openssl rand -base64 48
FLOWCAST_JWT_SECRET=
FLOWCAST_ACCESS_TOKEN_TTL=15m
FLOWCAST_REFRESH_TOKEN_TTL=720h

# --- AI ---
OPENAI_API_KEY=
FLOWCAST_ANALYSIS_MODEL=
FLOWCAST_POSTMORTEM_MODEL=
FLOWCAST_EMBEDDING_MODEL=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
