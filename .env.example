# FlowCast environment configuration.
#
# Copy to .env and fill in the required values. Never commit .env.
# Docker Compose reads this file's .env sibling too, so one file configures the whole
# local stack. Real environments set these as actual environment variables; anything
# already present in the environment wins over the .env file.
#
# Required: FLOWCAST_DATABASE_URL, FLOWCAST_REDIS_URL, FLOWCAST_JWT_SECRET.
# Everything else is optional and falls back to the default shown in the comment.

# --- Server ---
FLOWCAST_ENV=development                  # development | test | production
FLOWCAST_HTTP_PORT=8080
FLOWCAST_LOG_LEVEL=info                   # debug | info | warn | error
#FLOWCAST_HTTP_READ_TIMEOUT=15s
#FLOWCAST_HTTP_WRITE_TIMEOUT=30s
#FLOWCAST_HTTP_IDLE_TIMEOUT=60s
#FLOWCAST_SHUTDOWN_TIMEOUT=15s
#FLOWCAST_CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (required) ---
FLOWCAST_DATABASE_URL=postgres://flowcast:flowcast@localhost:5432/flowcast?sslmode=disable
#FLOWCAST_DATABASE_MAX_CONNS=10
#FLOWCAST_DATABASE_MIN_CONNS=2
#FLOWCAST_DATABASE_MAX_CONN_LIFETIME=1h
#FLOWCAST_DATABASE_MAX_CONN_IDLE_TIME=30m

# --- Redis (required) ---
FLOWCAST_REDIS_URL=redis://localhost:6379/0

# --- Auth (required) ---
# Must be at least 32 characters. Generate with: openssl rand -base64 48
FLOWCAST_JWT_SECRET=
#FLOWCAST_ACCESS_TOKEN_TTL=15m
#FLOWCAST_REFRESH_TOKEN_TTL=720h

# --- AI ---
# mock returns canned analyses and needs no credentials -- it is the default, and what the
# test suite uses. Switch to openai to make real API calls; the key and all three model
# names then become required.
FLOWCAST_AI_PROVIDER=mock                 # openai | mock
OPENAI_API_KEY=
FLOWCAST_ANALYSIS_MODEL=
FLOWCAST_POSTMORTEM_MODEL=
FLOWCAST_EMBEDDING_MODEL=
# Must match the vector column width in the migrations.
#FLOWCAST_EMBEDDING_DIMENSIONS=1536
#FLOWCAST_AI_REQUEST_TIMEOUT=60s

# --- Docker Compose ---
# Credentials the local postgres container is provisioned with. These are local-only
# development defaults; they must match FLOWCAST_DATABASE_URL above.
POSTGRES_USER=flowcast
POSTGRES_PASSWORD=flowcast
POSTGRES_DB=flowcast
# Host ports. Change these if 5432 or 6379 are already taken on your machine.
FLOWCAST_POSTGRES_PORT=5432
FLOWCAST_REDIS_PORT=6379

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
